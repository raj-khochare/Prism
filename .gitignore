# Environment variables and secrets (the *.example templates ARE committed)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Node.js / frontend build output
**/node_modules/
Frontend/dist/

# Java / Gradle (bin/ is Eclipse's output folder)
**/build/
**/bin/
**/.gradle/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar

# Python
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/.pytest_cache/
**/.mypy_cache/

# ML artefacts: keep code and small metadata in git, not raw data or big binaries
ml/data/raw/
ml/data/*.parquet
ml/runs/

# Hardhat
blockchain-env/artifacts/
blockchain-env/cache/
blockchain-env/deployments/

# IDE / OS
.idea/
**/.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
Desktop.ini

# Logs and backups (a 14 MB git bundle used to live in the project root)
*.log
*.bundle
*.bak

# Load testing artifacts
load-tests/results/*
!load-tests/results/.gitkeep
load-tests/reports/*
!load-tests/reports/.gitkeep
