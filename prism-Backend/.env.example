# Copy to .env (never commit .env). Docker Compose reads prism-Backend/.env for the backend.
DB_URL=jdbc:postgresql://postgres:5432/prism
DB_USERNAME=Prism
DB_PASSWORD=change-me

SLITHER_SERVICE_URL=http://static-analyzer:8001
ML_SERVICE_URL=http://ml-service:8002
RPC_URL=http://hardhat-node:8545
CORS_ALLOWED_ORIGINS=http://localhost:5173

# 32+ random characters, e.g. `openssl rand -base64 48`
JWT_SECRET_KEY=generate_a_secure_random_string_for_local_testing

TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Runtime detectors (see docs/PHASE1_RUNBOOK.md) ---
# Printed by scripts/replay-oracle.js:  <lenderAddress>=<poolAddress>
ORACLE_POOLS=
ORACLE_DEVIATION_THRESHOLD_PCT=5
# Optional extras (Aave V3 / Balancer V2 / the local mock lender are built in)
FLASH_LOAN_TOPICS=
FLASH_LOAN_LENDERS=
