# ============================================================
# PRISM Locust Load Testing Configuration
# Copy this file to .env before running tests:
#   cp .env.example .env   (or Copy-Item .env.example .env in PowerShell)
# ============================================================

# Target Base URL for PRISM Core Spring Boot Backend
PRISM_BASE_URL=http://127.0.0.1:8080

# Secondary Services (Optional / Specialized)
PRISM_STATIC_ANALYZER_URL=http://127.0.0.1:8001
PRISM_ML_SERVICE_URL=http://127.0.0.1:8002

# Credentials for Load Testing User
# The test harness will attempt login with these credentials or register them if missing
PRISM_TEST_USERNAME=loadtest_user
PRISM_TEST_PASSWORD=Password123!
PRISM_TEST_ROLE=DEVELOPER

# Optional: Pre-generated JWT Token (If set, skips login request during user setup)
PRISM_AUTH_TOKEN=

# Request timeout in seconds
PRISM_REQUEST_TIMEOUT=15.0

# User wait time between task iterations (in seconds)
PRISM_MIN_WAIT_SECONDS=1.0
PRISM_MAX_WAIT_SECONDS=3.0

# Performance Targets / SLO Thresholds
SLO_MAX_FAILURE_RATE_PCT=1.0
SLO_MAX_P95_LATENCY_MS=500.0
SLO_MAX_P99_LATENCY_MS=1500.0

# High Scale (50k Request Target) Parameters
SCALE_MAX_USERS=100
SCALE_SPAWN_RATE=10
SCALE_MAX_DURATION=60m
SCALE_TARGET_REQUESTS=50000
